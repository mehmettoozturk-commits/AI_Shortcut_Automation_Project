{
  "name": "ai-automation-core",
  "version": "0.1.0",
  "private": true,
  "description": "AI Shortcut Automation Platform — AI Core (Automation DSL, Capability Registry, Validators)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "esbuild src/ui/app.ts --bundle --format=iife --target=es2020 --minify --outfile=web/app.bundle.js",
    "build:web": "npm run bundle && node scripts/build-web.mjs",
    "serve": "tsx src/api/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
